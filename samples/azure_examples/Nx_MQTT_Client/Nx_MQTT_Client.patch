+  /* ── DigiCert mTLS: add device client certificate ───────────────────────
+   *
+   * If the CLM module has a valid device certificate, load it into the TLS
+   * session so the broker can authenticate this device (mutual TLS / mTLS).
+   *
+   * The MQTT broker must be configured to require client certificates signed
+   * by the DigiCert Device Trust Manager CA.
+   *
+   * NX_SECURE_X509_KEY_TYPE_EC_DER expects an EC private key in PKCS#8 DER
+   * format (the format produced by TrustCore NanoCrypto and by openssl pkcs8).
+   */
+  if (device_cert_loaded && device_cert_len > 0 && device_key_len > 0)
+  {
+    memset(&device_tls_cert, 0, sizeof(device_tls_cert));
