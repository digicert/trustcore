+/* mkdir stub for TrustEdge on ThreadX — the RAM VFS uses flat path strings so
+ * directory creation is always a no-op; returning 0 satisfies UTILS_mkdir().   */
+int mkdir(const char *pathname, mode_t mode)
+{
+  (void)pathname;
+  (void)mode;
+  return 0;
+}
+
+/* pthread_join stub — TrustEdge calls pthread_join in PREINSTALL/INSTALLED code
+ * paths that are never reached when the device is already PROVISIONED.  The
+ * symbol must exist to satisfy the linker; the body is never executed.         */
+int pthread_join(unsigned long thread, void **retval)
+{
+  (void)thread;
+  (void)retval;
+  return 0;
+}
