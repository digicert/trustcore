+/**
+* @brief  Populate mTLS certificate buffers for the MQTT thread.
+*         Called by the TrustEdge thread after successful enrollment.
+*/
+void APP_SetDeviceCert(const uint8_t *cert, uint32_t cert_len,
+                       const uint8_t *key,  uint32_t key_len)
+{
+  if (cert && cert_len > 0 && cert_len <= sizeof(device_cert_buf))
+  {
+    memcpy(device_cert_buf, cert, cert_len);
+    device_cert_len = (UINT)cert_len;
+  }
+  if (key && key_len > 0 && key_len <= sizeof(device_key_buf))
+  {
+    memcpy(device_key_buf, key, key_len);
+    device_key_len = (UINT)key_len;
+  }
+  if (device_cert_len > 0 && device_key_len > 0)
+    device_cert_loaded = 1;
 }
 
