+              NX_NULL, 0,
+              device_key_buf, (USHORT)device_key_len,
+              NX_SECURE_X509_KEY_TYPE_EC_DER);
+
+    if (ret != NX_SUCCESS)
+    {
+      printf("[CLM] WARNING: Failed to parse device certificate (0x%08lx).\r\n"
+             "[CLM]          Continuing without mTLS.\r\n", (ULONG)ret);
+    }
+    else
